APP_NAME="CMS - Hội Thánh Tin Lành"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://quanly.domain-hoi-thanh.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ten_database
DB_USERNAME=ten_user_db
DB_PASSWORD=mat_khau_db

# ─── Thông tin Hội Thánh (dùng bởi FoundationSeeder) ────────────────────────
CHURCH_NAME="Hội Thánh Tin Lành"
CHURCH_EMAIL=contact@domain-hoi-thanh.com
CHURCH_ADDRESS="Địa chỉ Hội Thánh"
CHURCH_PHONE=0123456789
SYSTEM_DOMAIN=domain-hoi-thanh.com

# ─── Tài khoản SuperAdmin (tạo lúc seed) ─────────────────────────────────────
# Login: superadmin@SYSTEM_DOMAIN
SUPERADMIN_PASSWORD=Abc.1234@HT

# ─── Cache / Session ─────────────────────────────────────────────────────────
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# ─── Mail (Notifications) ────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@domain-hoi-thanh.com
MAIL_FROM_NAME="${CHURCH_NAME}"

# ─── Storage ─────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
